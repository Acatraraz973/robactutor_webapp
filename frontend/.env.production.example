# Copy to .env.production before running `npm run build` for the public
# deployment. Leave unset (or don't copy this file) for local dev --
# api.js falls back to the same-origin /api/ask route in that case.
#
# Set this to your HF Space's base URL once it's created, e.g.:
#   VITE_ASK_API_BASE=https://<your-username>-robactutor-ask.hf.space
VITE_ASK_API_BASE=
