# Copy this file to .env and adjust as needed. All values below already
# default to sensible paths (see app/config.py) — you only need this file
# to override something.

# --- Base model + fine-tuned adapter -------------------------------------
# From robactutor_lora_adapters_BRI23222497.zip
BASE_MODEL_NAME=OpenLLM-Ro/RoMistral-7B-Instruct
ADAPTER_PATH=artifacts/lora_adapter

# --- RAG artefacts (from robactutor_rag_BRI23222497.zip) -----------------
RAG_INDEX_PATH=artifacts/rag/robactutor_faiss.index
RAG_CHUNKS_PATH=artifacts/rag/robactutor_chunks.json
RAG_EMBEDDER_NAME=all-MiniLM-L6-v2

# --- Practice question bank (157 instruction/response pairs) -------------
DATASET_PATH=artifacts/dataset/robactutor_sft_dataset_reviewed.jsonl

# --- Hybrid grading embedder ----------------------------------------------
HYBRID_EMBEDDER_NAME=paraphrase-multilingual-mpnet-base-v2
